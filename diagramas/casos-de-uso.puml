@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontColor #E8EBF2
skinparam backgroundColor #0B0E14

skinparam title {
  FontColor #7DB8E8
  FontSize 20
}

skinparam actor {
  BackgroundColor #12161F
  BorderColor #7DB8E8
  FontColor #E8EBF2
}

skinparam arrow {
  Color #5A6478
  FontColor #93A0B8
}

skinparam rectangle {
  BackgroundColor #0B0E14
  BorderColor #232838
  FontColor #7DB8E8
}

skinparam note {
  BackgroundColor #12161F
  BorderColor #232838
  FontColor #93A0B8
}

' Colores por grupo de actor (mismo código que el diagrama de trazabilidad)
skinparam usecase {
  BackgroundColor<<Cliente>> #16324A
  BorderColor<<Cliente>> #3B82C4
  FontColor<<Cliente>> #A9D1F0

  BackgroundColor<<Profesional>> #14301F
  BorderColor<<Profesional>> #3FAE6A
  FontColor<<Profesional>> #7FE3AB

  BackgroundColor<<Admin>> #281F3A
  BorderColor<<Admin>> #9B6FD6
  FontColor<<Admin>> #C9ADF0

  BackgroundColor<<Sistema>> #3A2A14
  BorderColor<<Sistema>> #D97B2A
  FontColor<<Sistema>> #F0BD8C

  BackgroundColor<<Extra>> #1A1F2C
  BorderColor<<Extra>> #444D63
  FontColor<<Extra>> #93A0B8
}

title La cadena completa: Casos de Uso — Sistema de Turnos y Citas

actor Cliente
actor Profesional
actor "Administrador de\nEmpresa" as Admin
actor "Sistema\n" as Sistema
actor "Servicio de\nNotificaciones" as Notificaciones

rectangle "Sistema de Turnos y Citas" {
  usecase "CU-001\nReservar Turno" as UC1 <<Cliente>>
  usecase "CU-002\nCancelar Turno" as UC2 <<Cliente>>
  usecase "CU-003\nReprogramar Turno" as UC3 <<Cliente>>
  usecase "CU-004\nConfigurar Disponibilidad" as UC4 <<Profesional>>
  usecase "CU-005\nConsultar Agenda" as UC5 <<Profesional>>
  usecase "CU-006\nGestionar Servicios" as UC6 <<Admin>>
  usecase "CU-007\nGestionar Profesionales" as UC7 <<Admin>>
  usecase "CU-008\nEnviar Recordatorio" as UC8 <<Sistema>>

  usecase "Enviar Notificación\npor correo" as UCNotif <<Extra>>
  usecase "Advertir conflicto de\nfranjas / turnos afectados" as UCWarnDisp <<Extra>>
  usecase "Advertir turnos futuros\npendientes al dar de baja" as UCWarnProf <<Extra>>
}

' --- Actores principales ---
Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente <.. UC8 : recibe

Profesional --> UC4
Profesional --> UC5

Admin --> UC6
Admin --> UC7

Sistema --> UC8

' --- include ---
UC1 ..> UCNotif : <<include>>
UC2 ..> UCNotif : <<include>>
UC3 ..> UCNotif : <<include>>
UC8 ..> UCNotif : <<include>>
UCNotif --> Notificaciones

' --- extend (comportamiento opcional/condicional) ---
UCWarnDisp ..> UC4 : <<extend>>
UCWarnProf ..> UC7 : <<extend>>

' --- Dependencias funcionales (no son include/extend UML,
'     se documentan como notas porque una HU/CU necesita
'     que otra ya exista) ---
note right of UC1
  Requiere disponibilidad
  vigente cargada en CU-004
end note

note right of UC3
  Ejecuta en una única transacción
  atómica: libera el turno anterior
  + reserva uno nuevo (lógica de CU-001)
end note

note bottom of UC5
  Vista de solo lectura sobre el
  estado que generan CU-001,
  CU-002 y CU-003
end note

note bottom of UC7
  Requiere al menos un servicio
  activo dado de alta en CU-006
end note

legend right
  |<back:#16324A>    </back>| Cliente |
  |<back:#14301F>    </back>| Profesional |
  |<back:#281F3A>    </back>| Administrador de empresa |
  |<back:#3A2A14>    </back>| Sistema / soporte |
  |<back:#1A1F2C>    </back>| CU auxiliar (include / extend) |
endlegend

@enduml
