@startuml
left to right direction
skinparam shadowing false
skinparam backgroundColor #0B0E14
skinparam defaultFontColor #E8EBF2

skinparam title {
  FontColor #7DB8E8
  FontSize 20
}

skinparam package {
  BackgroundColor #0B0E14
  BorderColor #232838
  FontColor #93A0B8
  FontSize 12
}

skinparam arrow {
  Color #5A6478
  FontColor #93A0B8
}

skinparam rectangle {
  BackgroundColor<<RF>> #16324A
  BorderColor<<RF>> #3B82C4
  FontColor<<RF>> #A9D1F0

  BackgroundColor<<RNF>> #3A2A14
  BorderColor<<RNF>> #D97B2A
  FontColor<<RNF>> #F0BD8C

  BackgroundColor<<HU>> #14301F
  BorderColor<<HU>> #3FAE6A
  FontColor<<HU>> #7FE3AB

  BackgroundColor<<CU>> #281F3A
  BorderColor<<CU>> #9B6FD6
  FontColor<<CU>> #C9ADF0
}

title La cadena completa Sistema de Turnos

package "HU-01 / CU-01" {
  rectangle "RF-09\nRF-10\nRF-11\nRF-12\nRF-13\nRF-28 (seña)" as RF1 <<RF>>
  rectangle "RNF-01\nRNF-03\nRNF-04" as RNF1 <<RNF>>
  rectangle "HU-01\nReservar Turno\n(Cliente)" as HU1 <<HU>>
  rectangle "CU-01\nReservar Turno" as CU1 <<CU>>
  RF1 -down-> HU1
  RNF1 .down.> HU1
  HU1 -down-> CU1
}

